// -*- mode: jsonc -*-
{
  "layer": "top", // Waybar at top layer
  "position": "top", // Waybar position (top|bottom|left|right)
  "height": 38, // Waybar height (to be removed for auto height)
  "margin-top": 0,
  "spacing": 0, // Gaps between modules
  "modules-left": ["custom/rofi", "ext/workspaces", "hyprland/window"],
  "modules-center": [],
  "modules-right": [
    // "mpris",
    "group/tray-expander",
    "custom/colorpicker",
    "custom/wallpaper",
    "pulseaudio",
    "clock",
    "custom/notification",
    "custom/power",
  ],
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "children-class": "tray-group-item",
    },
    "modules": ["custom/expand-icon", "tray"],
  },
  "custom/expand-icon": {
    "format": "",
    "tooltip": false,
  },
  "tray": {
    "icon-size": 15,
    "spacing": 8,
  },
  "ext/workspaces": {
    "sort-by-id": true,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch \"hl.dsp.focus({workspace = 'e-1'})\"",
    "on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({workspace = 'e+1'})\"",
    // "format": "{icon}",
    // "format-icons": {
    //   "1": "一",
    //   "2": "二",
    //   "3": "三",
    //   "4": "四",
    //   "5": "五",
    //   "6": "六",
    //   "7": "七",
    //   "8": "八",
    //   "9": "九",
    //   "10": "十",
    // },
  },
  "clock": {
    // "timezone": "America/New_York",
    "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%A, %d %B %Y - %H:%m}",
  },
  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    "format": "<span color='#d6a9a0'>{icon}</span> {volume}%",
    "format-bluetooth": "{icon} {volume}% -  {format_source}",
    "format-bluetooth-muted": "{icon}  -  {format_source}",
    "format-muted": " {format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "on-click": "pavucontrol",
  },
  "custom/notification": {
    "exec": "~/.local/bin/waybar-mako-notif.py",
    "restart-interval": 0,
    "return-type": "json",
    "read-stdin": true,
    "format": "<span color='#d9a25f'></span> {text}",
    "tooltip": "{tooltip}",
    "class": "{class}",
    "on-click": "makoctl dismiss --all",
  },
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/rofi/powermenu.sh",
    "on-click-right": "hyprctl dispatch exit",
    "interval": 60,
  },
  "custom/colorpicker": {
    "format": "",
    "tooltip": "Pick a color",
    "on-click": "sleep 0.1 && hyprpicker -a -f hex && notify-send 'Color copied to clipboard'",
  },
  "custom/wallpaper": {
    "format": "",
    "tooltip-format": "Change Wallpaper",
    "on-click": "waypaper --random",
    "on-click-right": "waypaper",
  },
  "custom/rofi": {
    "format": "󱗼",
    "tooltip": "Launch Rofi",
    "on-click": "rofi -show drun",
  },
  "mpris": {
    "format": "{player_icon} {title} - {artist}",
    "format-paused": "{status_icon} <i>{title} - {artist}</i>",
    "player-icons": {
      "default": "",
    },
    "status-icons": {
      "paused": "",
    },
    "max-length": 35,
    "interval": 1,
  },
}
